{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scan-ai.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/apple-verify", "destination": "/api/apple?action=verify" },
    { "source": "/api/apple-notifications", "destination": "/api/apple?action=notifications" },
    { "source": "/api/export-data", "destination": "/api/account?action=export" },
    { "source": "/api/delete-account", "destination": "/api/account?action=delete" },
    { "source": "/api/assistant", "destination": "/api/recommend?action=assistant" },
    { "source": "/api/face-scan", "destination": "/api/scan-ai?action=face" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
